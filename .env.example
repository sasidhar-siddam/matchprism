# MatchPrism Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.

# ---------------------------------------------------------------------------
# Next.js / Frontend
# ---------------------------------------------------------------------------

# Canonical site URL used for Open Graph metadata and sitemap generation.
# In production set this to your actual domain.
# Required by: src/app/layout.tsx (metadataBase)
NEXT_PUBLIC_SITE_URL=https://matchprism.com

# ---------------------------------------------------------------------------
# Python data pipeline (optional — scripts/fetch_live_odds.py)
# ---------------------------------------------------------------------------

# The Odds API key — free tier at https://the-odds-api.com (500 req/month).
# Only needed if you want live bookmaker odds via fetch_live_odds.py.
# Without this key the script falls back to mock data.
ODDS_API_KEY=your_odds_api_key_here

# ---------------------------------------------------------------------------
# Python data pipeline (optional — scripts/pitch_scanner.py)
# ---------------------------------------------------------------------------

# OpenWeather API key — free tier at https://openweathermap.org/api.
# Only needed for live dew/weather data in the pitch scanner.
# Without this key the script uses historical averages.
OPENWEATHER_API_KEY=your_openweather_api_key_here
